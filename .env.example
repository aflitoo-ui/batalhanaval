# String de conexão do Postgres (ex: Neon). Copie da tela do Neon
# ("Connection string") depois de criar o banco.
DATABASE_URL=postgresql://usuario:senha@host/nome_do_banco?sslmode=require

# Credenciais do único login do sistema (rodadas pelo "npm run db:seed").
# Depois de rodar o seed, pode remover ADMIN_PASSWORD daqui se quiser
# (só é lido nesse momento, não fica salvo em texto puro no banco).
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=escolha-uma-senha-forte

# Gateway de pagamento (assinaturas). Pegue a API key no painel da Asaas em
# Configurações > Integrações > API. O token de webhook você escolhe e
# cadastra em Configurações > Integrações > Webhooks — precisa ser o mesmo
# valor dos dois lados.
PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Deixe em branco pra produção. Pra testar sem cobrar de verdade, use:
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_BASE_URL=
